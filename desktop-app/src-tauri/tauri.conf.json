{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "BamBumPOS",
    "version": "1.0.0",
    "identifier": "com.bambumpos.desktop",
    "build": {
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "BamBumPOS",
                "width": 1440,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 640,
                "resizable": true,
                "fullscreen": false,
                "center": true,
                "url": "https://bambumpos.com/panel"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.png",
            "icons/icon.ico"
        ],
        "copyright": "BamBumPOS",
        "category": "Business",
        "shortDescription": "Adisyon, kasa ve mutfak ekranları",
        "longDescription": "BamBumPOS masaüstü uygulaması: kasa, adisyon ve mutfak ekranlarını kendi penceresinde açar."
    }
}
