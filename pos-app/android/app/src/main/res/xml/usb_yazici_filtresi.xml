    <usb-device vendor-id="5380" />
    <!-- Citizen 0x1d90 -->
    <usb-device vendor-id="7568" />
    <!-- Winbond yongalı POS-58 0x0416:0x5011 -->
    <usb-device vendor-id="1046" product-id="20497" />
    <!-- ICS yongalı fiş yazıcısı 0x0fe6:0x811e -->
    <usb-device vendor-id="4070" product-id="33054" />
